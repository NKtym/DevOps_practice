environments:
  dev:
    values:
      - environments/common.env.yaml
      - environments/dev/env.yaml
  prod:
    values:
      - environments/common.env.yaml
      - environments/prod/env.yaml

---

releases:
  - name: app-dev
    namespace: iv222
    chart: ./hawk-chart
    createNamespace: false
    labels:
      env: dev
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" | quote }}
          tag: {{ requiredEnv "IMAGE_TAG" | quote }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - externalAppUrl: {{ .Environment.Values.externalAppUrl | quote }}
      - ciliumNetworkPolicy:
          enabled: true
          allowCluster: true
          peers:
{{ toYaml .Environment.Values.networkPeers | indent 12 }}
      - ingress:
          enabled: true
          className: hawk-dev
          annotations:
            traefik.ingress.kubernetes.io/router.middlewares: "iv222-app-dev-hawk-chart-headers@kubernetescrd"
            traefik.ingress.kubernetes.io/router.entrypoints: "websecure"
            traefik.ingress.kubernetes.io/router.tls: "true"
          hosts:
            - host: "iv222s03-dev.hawk-dev.csc.sibsutis.ru"
              paths:
                - path: /
                  pathType: Prefix

  - name: app-prod
    namespace: iv222
    chart: ./hawk-chart
    createNamespace: false
    labels:
      env: prod
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" | quote }}
          tag: {{ requiredEnv "IMAGE_TAG" | quote }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - externalAppUrl: {{ .Environment.Values.externalAppUrl | quote }}
      - ciliumNetworkPolicy:
          enabled: true
          allowCluster: true
          peers:
{{ toYaml .Environment.Values.networkPeers | indent 12 }}
      - ingress:
          enabled: true
          className: hawk-dev
          annotations:
            traefik.ingress.kubernetes.io/router.middlewares: "iv222-app-prod-hawk-chart-headers@kubernetescrd"
            traefik.ingress.kubernetes.io/router.entrypoints: "websecure"
            traefik.ingress.kubernetes.io/router.tls: "true"
          hosts:
            - host: "iv222s03-prod.hawk-dev.csc.sibsutis.ru"
              paths:
                - path: /
                  pathType: Prefix