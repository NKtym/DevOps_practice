environments:
  dev:
    values:
      - environments/common.env.yaml
      - environments/dev/env.yaml
  prod:
    values:
      - environments/common.env.yaml
      - environments/prod/env.yaml

---

releases:
  # Dev release
  - name: app-dev
    namespace: iv222
    chart: ./hawk-chart
    createNamespace: false
    labels:
      env: dev
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" }}
          tag: {{ env "IMAGE_TAG" }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - ingress:
          enabled: true
          className: hawk-dev
          hosts:
            - host: "{{ printf "%s.%s" (default .Environment.Values.HOST_NAME "app-dev") (default .Environment.Values.HOST_BASE "hawk.csc.sibsutis.ru") }}"

  - name: app-prod
    namespace: iv222
    chart: ./hawk-chart
    createNamespace: false
    labels:
      env: prod
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" }}
          tag: {{ env "IMAGE_TAG" }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - ingress:
          enabled: true
          className: hawk-prod
          hosts:
            - host: "{{ printf "%s.%s" (default .Environment.Values.HOST_NAME "app-prod") (default .Environment.Values.HOST_BASE "hawk.csc.sibsutis.ru") }}"