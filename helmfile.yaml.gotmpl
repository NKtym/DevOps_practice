environments:
  dev:
    values:
      - environments/common.env.yaml
      - environments/dev/env.yaml
  prod:
    values:
      - environments/common.env.yaml
      - environments/prod/env.yaml

---

releases:
  - name: app-dev
    installed: {{ eq .Environment.Name "dev" }}
    namespace: iv222
    chart: ./hawk-chart
    labels:
      env: dev
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" | quote }}
          tag: {{ requiredEnv "IMAGE_TAG" | quote }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - externalAppUrl: {{ .Environment.Values.externalAppUrl | quote }}
      - ciliumNetworkPolicy:
          enabled: true
          allowCluster: true
          peers:
{{ toYaml .Environment.Values.networkPeers | indent 12 }}
      - ingress:
          enabled: true
          className: hawk-dev
          hosts:
            - host: "iv222s03-dev.hawk-dev.csc.sibsutis.ru"
              paths:
                - path: /
                  pathType: Prefix

  - name: app-prod
    installed: {{ eq .Environment.Name "prod" }}
    namespace: iv222
    chart: ./hawk-chart
    labels:
      env: prod
    values:
      - image:
          repository: {{ env "HAWK_REGISTRY_IMAGE" | quote }}
          tag: {{ requiredEnv "IMAGE_TAG" | quote }}
      - replicaCount: {{ default .Environment.Values.REPLICA_COUNT 1 }}
      - owner: {{ default .Environment.Values.APP_OWNER "" }}
      - deployTimestamp: {{ default .Environment.Values.DEPLOY_TIMESTAMP "" }}
      - externalAppUrl: {{ .Environment.Values.externalAppUrl | quote }}
      - ciliumNetworkPolicy:
          enabled: true
          allowCluster: true
          peers:
{{ toYaml .Environment.Values.networkPeers | indent 12 }}
      - ingress:
          enabled: true
          className: hawk-dev
          hosts:
            - host: "iv222s03-prod.hawk-dev.csc.sibsutis.ru"
              paths:
                - path: /
                  pathType: Prefix